{
  "name": "portal-tcc-api",
  "version": "1.0.0",
  "private": true,
  "description": "API do Portal TCC ABNT (Cloudflare Worker + D1 + R2)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute portal-tcc --local --file=../../database/migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute portal-tcc --remote --file=../../database/migrations/0001_init.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
